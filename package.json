{
  "name": "gitbot-ai",
  "version": "0.0.3",
  "description": "Run Claude Code, Codex, or OpenCode from any device on your network — a local server that puts an AI coding agent in your browser, with reusable bots, threads, and per-bot setup instructions.",
  "main": "dist/index.js",
  "bin": {
    "gitbot": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "codex",
    "opencode",
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "bot",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anildukkipatty/grass-ide.git"
  },
  "author": "anildukkipatty",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.42",
    "@openai/codex-sdk": "^0.130.0",
    "@opencode-ai/sdk": "^1.2.15",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^25.2.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
