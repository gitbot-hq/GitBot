{
  "name": "@gitbot-hq/gitbot",
  "version": "0.0.7",
  "description": "Run Claude Code, Codex, or OpenCode from any device on your network — a local server that puts an AI coding agent in your browser, with reusable bots, threads, and per-bot setup instructions.",
  "main": "dist/index.js",
  "bin": {
    "gitbot": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:cli && npm run build:ui",
    "build:cli": "tsc",
    "postbuild:cli": "node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "build:ui": "node scripts/build-ui.mjs",
    "test": "npm run build:cli && node --test \"scripts/*.test.mjs\"",
    "dev": "tsx src/index.ts",
    "postinstall": "node scripts/postinstall.mjs || exit 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "codex",
    "opencode",
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "bot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitbot-hq/GitBot.git"
  },
  "homepage": "https://github.com/gitbot-hq/GitBot#readme",
  "bugs": {
    "url": "https://github.com/gitbot-hq/GitBot/issues"
  },
  "author": "gitbot-hq",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.42",
    "@openai/codex-sdk": "^0.155.1",
    "@opencode-ai/sdk": "^1.2.15",
    "commander": "^14.0.3",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
